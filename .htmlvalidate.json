{
  "extends": ["html-validate:recommended"],
  "rules": {
    "trailing-whitespace": "off",
    "doctype-style": "off",
    "attr-quotes": "off",
    "valid-id": "off",
    "valid-autocomplete": "off",
    "wcag/h32": "off",
    "wcag/h30": "off",
    "attribute-allowed-values": "off",
    "unique-landmark": "off",
    "element-permitted-content": "off"
  }
}
