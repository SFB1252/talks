BEGIN:VEVENT
UID:workshop-11-bayesian-regression@sfb1252.uni-koeln.de
DTSTAMP:20251013T120000Z
DTSTART:20251112T130000Z
DTEND:20251112T143000Z
SUMMARY:Workshop 11: Bayesian Regression Models
LOCATION:House of Prominence\, Attic (Top floor)\, Luxemburger Str. 299\, Cologne
DESCRIPTION:Introduction to Bayesian statistical thinking\, Bayesian vs. frequentist approaches\, implementing Bayesian regression in R (brms\, rstanarm)\, prior specification\, and interpreting results.\n\nSpeaker: Job Schepens\, Project S\, CRC 1252\n\nMore info: https://sfb1252.github.io/talks/workshops/11-bayesian-regression-models/
URL:https://sfb1252.github.io/talks/workshops/11-bayesian-regression-models/
ORGANIZER;CN=Job Schepens & Luke Günther:mailto:info@sfb1252.uni-koeln.de
STATUS:CONFIRMED
SEQUENCE:0
END:VEVENT

