{
  "httpStatusCodes": [400, 401, 403, 404, 500, 502, 503],
  "timeout": "10s",
  "retryOn429": true,
  "retryCount": 2,
  "fallbackHttpStatus": [400, 401, 403, 404, 500, 502, 503],
  "aliveStatusCodes": [200, 206, 301, 302],
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    },
    {
      "pattern": "^https://localhost"
    },
    {
      "pattern": "^http://127.0.0.1"
    },
    {
      "pattern": "^https://example.com"
    },
    {
      "pattern": "^mailto:"
    },
    {
      "pattern": "^tel:"
    },
    {
      "pattern": "^#"
    },
    {
      "pattern": "^javascript:"
    },
    {
      "pattern": "discord.gg"
    },
    {
      "pattern": "twitter.com"
    },
    {
      "pattern": "linkedin.com"
    },
    {
      "pattern": "facebook.com"
    }
  ]
}
